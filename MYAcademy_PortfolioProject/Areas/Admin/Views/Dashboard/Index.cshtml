@model MYAcademy_PortfolioProject.Areas.Admin.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var stats = new[]
    {
        (Val: Model.TotalProjects, Lbl: "Toplam Proje", Icon: "bi-folder", Cls: "c-green"),
        (Val: Model.ActiveProjects, Lbl: "Aktif Proje", Icon: "bi-check-circle", Cls: "c-blue"),
        (Val: Model.TotalSkills, Lbl: "Yetenek", Icon: "bi-lightning", Cls: "c-green"),
        (Val: Model.TotalExperiences, Lbl: "Deneyim", Icon: "bi-briefcase", Cls: "c-blue"),
        (Val: Model.TotalEducations, Lbl: "Eğitim", Icon: "bi-mortarboard", Cls: "c-green"),
        (Val: Model.TotalMessages, Lbl: "Toplam Mesaj", Icon: "bi-envelope", Cls: "c-blue"),
        (Val: Model.UnreadMessages, Lbl: "Okunmamış Mesaj", Icon: "bi-envelope-exclamation", Cls: "c-rose"),
       
    };
}

<style>
    .db {
        --g: #2f5d4e;
        --g-soft: #e7efe9;
        --line: #ebe8e1;
        --muted: #8a8a85;
    }

    .db-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.4rem;
        height: 100%;
    }

    .db-title {
        font-weight: 600;
        margin-bottom: 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .stat-val {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat-lbl {
        color: var(--muted);
        font-size: .85rem;
        margin-top: .3rem;
    }

    .c-green {
        background: var(--g-soft);
        color: var(--g);
    }

    .c-blue {
        background: #e6eef8;
        color: #3b6ea5;
    }

    .c-rose {
        background: #f9e7e7;
        color: #b44b4b;
    }

    .msg-row {
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: .8rem 0;
        border-bottom: 1px solid var(--line);
    }

        .msg-row:last-child {
            border-bottom: none;
        }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--g-soft);
        color: var(--g);
        display: grid;
        place-items: center;
        font-weight: 600;
        flex-shrink: 0;
    }

    .msg-body {
        flex: 1;
        min-width: 0;
    }

        .msg-body p {
            margin: 0;
            color: var(--muted);
            font-size: .85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .badge-soft {
        font-size: .72rem;
        padding: .3rem .6rem;
        border-radius: 20px;
        white-space: nowrap;
    }

    .db-table {
        width: 100%;
        border-collapse: collapse;
    }

        .db-table th {
            color: var(--muted);
            font-size: .8rem;
            font-weight: 600;
            padding: .8rem;
            border-bottom: 1px solid var(--line);
        }

        .db-table td {
            padding: .9rem .8rem;
            border-bottom: 1px solid var(--line);
            font-size: .9rem;
        }

        .db-table tr:last-child td {
            border-bottom: none;
        }

    .db-link {
        color: var(--g);
        text-decoration: none;
        font-size: .85rem;
    }

        .db-link:hover {
            text-decoration: underline;
        }
</style>

<div class="db container-fluid py-3">

    <!-- İSTATİSTİK KARTLARI -->
    <div class="row g-4 mb-4">
        @foreach (var s in stats)
        {
            <div class="col-md-4 col-xl-3">
                <div class="db-card stat">
                    <div class="stat-icon @s.Cls">
                        <i class="bi @s.Icon"></i>
                    </div>
                    <div>
                        <div class="stat-val">@s.Val</div>
                        <div class="stat-lbl">@s.Lbl</div>
                    </div>
                </div>
            </div>
        }
        <div class="col-md-4 col-xl-3">
            <div class="db-card" style="height:100%;">
                <div class="db-title mb-3">
                    <span>
                        <i class="bi bi-lightning-charge me-2"></i>
                        Hızlı Erişim
                    </span>
                </div>

                <div class="d-flex flex-column gap-2">
                    <a asp-area="Admin"
                       asp-controller="Project"
                       asp-action="CreateProject"
                       class="db-link">
                        <i class="bi bi-plus-circle me-2"></i>
                        Yeni Proje Ekle
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Experience"
                       asp-action="ExperienceList"
                       class="db-link">
                        <i class="bi bi-briefcase me-2"></i>
                        Deneyimleri Yönet
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- KATEGORİ ÖZETİ VE SON PROJELER -->
    <div class="row g-4 mb-4">

        <!-- Kategori özeti -->
        <div class="col-xl-6">
            <div class="db-card">
                <div class="db-title">
                    Kategori Özeti
                    <i class="bi bi-grid text-muted"></i>
                </div>

                <div class="table-responsive">
                    <table class="db-table">
                        <thead>
                            <tr>
                                <th>Kategori</th>
                                <th class="text-end">Proje Sayısı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.CategorySummaries)
                            {
                                <tr>
                                    <td>@category.Key</td>
                                    <td class="text-end">
                                        <span class="badge-soft c-green">
                                            @category.Value
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!Model.CategorySummaries.Any())
                {
                    <p class="text-muted small mt-3">
                        Henüz kategori özeti bulunmuyor.
                    </p>
                }
            </div>
        </div>

        <!-- Son 3 proje -->
        <div class="col-xl-6">
            <div class="db-card">
                <div class="db-title">
                    Son Projeler
                    <i class="bi bi-folder2-open text-muted"></i>
                </div>

                <div class="table-responsive">
                    <table class="db-table">
                        <thead>
                            <tr>
                                <th>Proje</th>
                                <th>Kategori</th>
                                <th class="text-end">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in Model.LastProjects)
                            {
                                <tr>
                                    <td>@project.ProjectName</td>
                                    <td>@project.Category?.CategoryName</td>
                                    <td class="text-end">
                                        @if (project.isActive)
                                        {
                                            <span class="badge-soft c-green">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft c-rose">
                                                Pasif
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!Model.LastProjects.Any())
                {
                    <p class="text-muted small mt-3">
                        Henüz proje bulunmuyor.
                    </p>
                }
            </div>
        </div>

    </div>



    <!-- SON 5 MESAJ -->
    <div class="data-table-card p-4 mb-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Son Mesajlar</h4>

            <a asp-area="Admin"
               asp-controller="Message"
               asp-action="MessageList"
               class="db-link">
                Tümünü gör →
            </a>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Gönderen</th>
                        <th>E-posta</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.LastMessages)
                    {
                        <tr>
                            <td>@item.SenderName</td>
                            <td>@item.SenderEmail</td>
                            <td>@item.Subject</td>
                            <td>@item.SendDate.ToString("dd MMM yyyy")</td>

                            <td>
                                @if (item.IsRead)
                                {
                                    <span class="badge-soft c-blue">Okundu</span>
                                }
                                else
                                {
                                    <span class="badge-soft c-rose">Okunmadı</span>
                                }
                            </td>

                            <td class="text-end">
                                <button type="button"
                                        class="btn-action-icon btn-edit"
                                        title="Mesajı Aç"
                                        data-bs-toggle="modal"
                                        data-bs-target="#messageModal-@item.MessageId">
                                    <i class="bi bi-envelope-open"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.LastMessages.Any())
        {
            <p class="text-muted small">
                Henüz mesaj bulunmuyor.
            </p>
        }

    </div>


    @foreach (var item in Model.LastMessages)
    {
        <div class="modal fade"
             id="messageModal-@item.MessageId"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">@item.Subject</h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body">
                        <p><strong>Gönderen:</strong> @item.SenderName</p>
                        <p><strong>E-posta:</strong> @item.SenderEmail</p>
                        <p><strong>Tarih:</strong> @item.SendDate.ToString("dd.MM.yyyy HH:mm")</p>

                        <hr />

                        <p style="white-space: pre-wrap;">@item.MessageDetail</p>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Kapat
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }



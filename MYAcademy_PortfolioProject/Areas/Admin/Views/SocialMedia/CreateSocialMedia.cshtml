@model SocialMedia

@{
    ViewData["Title"] = "CreateSocialMedia";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="data-table-card p-4">

        <h4 class="fw-bold mb-4">Yeni Sosyal Medya Hesabı Ekle</h4>

        <form method="post" action="/Admin/SocialMedia/CreateSocialMedia">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Platform Adı</label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Örn: GitHub"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Bağlantı (URL)</label>
                <input asp-for="Url"
                       type="url"
                       class="form-control"
                       placeholder="Örn: https://github.com/kullaniciadi"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">İkon</label>
                <input asp-for="Icon"
                       class="form-control"
                       placeholder="Örn: bi bi-github"
                       required />
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-pastel-primary">
                    <i class="bi bi-check-lg me-2"></i>
                    Kaydet
                </button>

                <a href="/Admin/Contact/ContactList"
                   class="btn btn-outline-secondary">
                    İptal
                </a>
            </div>

        </form>
    </div>
</div>

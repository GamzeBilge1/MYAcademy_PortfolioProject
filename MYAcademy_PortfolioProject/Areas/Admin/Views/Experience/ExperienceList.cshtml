@model List<Experience>
@{
    ViewData["Title"] = "ExperienceList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<!-- CONTENT BODY -->
<main class="page-content-area">

    <!-- Page Header Row -->
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Deneyimlerim Listesi</h1>
         
        </div>
      @*   <div class="header-actions">
            <button class="btn-pastel-secondary" id="btnExport">
                <i class="bi bi-download"></i>
                <span>Dışa Aktar</span>
            </button>
            <button class="btn-pastel-primary" onclick="openAddModal()">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Deneyim Ekle</span>
            </button>
        </div> *@
    </div>

    <!-- 4 Statistics Summary Cards -->
    <div class="stats-row">
        <!-- 1. Toplam Deneyim -->
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-green">
                <i class="bi bi-briefcase"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Toplam Deneyim</span>
                <h3 class="stat-value" id="statTotalCount">@Model.Count</h3>
            </div>
        </div>

        <!-- 2. Aktif Kayıt -->
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-blue">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Aktif Kayıt</span>
                <h3 class="stat-value" id="statActiveCount">@Model.Count(x => x.isActive)</h3>
            </div>
        </div>

        <!-- 3. Pasif Kayıt -->
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-beige">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Pasif Kayıt</span>
                <h3 class="stat-value" id="statPassiveCount">@Model.Count(x => !x.isActive)</h3>
            </div>
        </div>

        <!-- 4. Son Güncelleme -->
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-purple">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Son Eklenen Deneyim</span>
                <h3 class="stat-value" style="font-size: 1.05rem;">
                    @(Model.OrderByDescending(x => x.ExperienceId).FirstOrDefault()?.Title ?? "Kayıt Yok")
                </h3>
            </div>
        </div>
    </div>

    <!-- Main Experience Table Container -->
    <div class="data-table-card">

        <!-- Filter / Action Toolbar -->
        <div class="table-filter-bar">
            <div class="filters-left-group">
                <div class="filter-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" id="tableSearchInput" placeholder="Deneyim başlığına göre ara...">
                </div>

                <select class="filter-select" id="statusFilterSelect">
                    <option value="all">Durum Seçiniz (Tümü)</option>
                    <option value="Aktif">Aktif</option>
                    <option value="Pasif">Pasif</option>
                </select>

                
            </div>

            <div class="filters-right-group">
                <button class="btn-table-util" id="btnRefreshTable" title="Tabloyu Yenile">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span class="d-none d-md-inline">Yenile</span>
                </button>
                <div class="dropdown">
                    <button class="btn-table-util dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="bi bi-sliders"></i>
                        Toplu İşlem
                    </button>

                    <ul class="dropdown-menu">
                        <li>
                            <button type="button" class="dropdown-item"
                                    onclick="bulkAction('activate')">
                                Aktif Yap
                            </button>
                        </li>

                        <li>
                            <button type="button" class="dropdown-item"
                                    onclick="bulkAction('deactivate')">
                                Pasif Yap
                            </button>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <button type="button" class="dropdown-item text-danger"
                                    onclick="bulkAction('delete')">
                                Seçilenleri Sil
                            </button>
                        </li>
                    </ul>
                </div>
                <button class="btn-pastel-primary" style="padding: 7px 14px; font-size: 0.8rem;" onclick=" document.getElementById('hizliEkle').scrollIntoView({ behavior: 'smooth' })">
                    <i class="bi bi-plus-lg"></i>
                    <span>Ekle</span>
                </button>
            </div>
        </div>

        <!-- Experience Table -->
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table" id="experienceTable">
                <thead>
                    <tr>
                        <th>
                            <input type="checkbox" id="selectAllCheckbox" class="custom-checkbox">
                        </th></th>
                        <th>ID</th>
                        <th>Deneyim Başlığı</th>
                        <th>Şirket / Kurum</th>
                        <th>Açıklama</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                        <th style="text-align: right;">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="experienceTableBody">
                    <!-- Record 1 -->
                    @foreach(var item in Model){
                        <tr data-id="@item.ExperienceId"
                            data-status="@(item.isActive ? "Aktif" : "Pasif")">
                            <td style="text-align: center;">
                                <input type="checkbox" class="custom-checkbox row-select-checkbox" value="@item.ExperienceId">
                            </td>
                            <td class="col-id">#@item.ExperienceId</td>
                            <td>
                                <div class="experience-title-cell">
                                    <div class="exp-icon-bullet">
                                        <i class="bi bi-laptop"></i>
                                    </div>
                                    <div>
                                        <span class="exp-title-text">@item.Title</span>
                                  
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="company-cell">
                                    <i class="bi bi-building company-badge-icon"></i>
                                    <span>@item.CompanyName</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted">@item.Description</span>
                            </td>
                            <td>
                                <span class="work-type-badge">@item.CategoryName</span>
                            </td>
                            <td>
                                @if (item.isActive)
                                {
                                    <span class="status-pill status-active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill status-passive">Pasif</span>
                                }
                            </td>
                            
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                           
                                    
                                    <a href="/Admin/Experience/UpdateExperience/@item.ExperienceId"
                                       class="btn-action-icon btn-edit"
                                       title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form action="/Admin/Experience/DeleteExperience/@item.ExperienceId"
                                          method="post" class="delete-form">

                                        <button type="submit"
                                                class="btn-action-icon btn-delete"
                                                title="Sil">
                                            <i class="bi bi-trash3"></i>
                                        </button>

                                    </form>
                                </div>
                            </td>
                        </tr>

                    }
                 
                  
                </tbody>
            </table>
        </div>

        <!-- Table Footer: Pagination & Counter -->
        <div class="table-footer-area">
            <div class="pagination-counter">
                Toplam <strong>@ViewBag.TotalCount</strong> kayıttan
                <strong>@((ViewBag.CurrentPage - 1) * 4 + 1)-@Math.Min(ViewBag.CurrentPage * 4, ViewBag.TotalCount)</strong>
                arası gösteriliyor
            </div>
            <ul class="custom-pagination">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-nav-item">
                        <a href="@Url.Action("ExperienceList", new { page = i })"
                           class="page-nav-btn @(i == ViewBag.CurrentPage ? "active" : "")">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Quick Add / Edit Side Panel & ASP.NET Core Integration Note -->

    <div class="side-drawer-card" id="hizliEkle">
        <div class="drawer-header">
            <div>
                <h3 class="drawer-title">
                    <i class="bi bi-plus-square"></i>
                    Deneyim Oluşturma Paneli
                </h3>
            </div>
        </div>

        <form id="inlineExperienceForm" method="post"
              action="/Admin/Experience/CreateExperience">

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label-custom">
                        Deneyim Başlığı <span class="required-star">*</span>
                    </label>
                    <input type="text" name="Title"
                           class="form-control-custom"
                           placeholder="Deneyim başlığını giriniz" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label-custom">
                        Şirket / Kurum Adı <span class="required-star">*</span>
                    </label>
                    <input type="text" name="CompanyName"
                           class="form-control-custom"
                           placeholder="Şirket adını giriniz" required>
                </div>

                <div class="col-md-12">
                    <label class="form-label-custom">Kategori</label>
                    <input type="text" name="CategoryName"
                           class="form-control-custom"
                           placeholder="Örn: Staj, İş Deneyimi">
                </div>

                <div class="col-12">
                    <label class="form-label-custom">Açıklama</label>
                    <textarea name="Description"
                              class="form-control-custom"
                              rows="3"
                              placeholder="Deneyiminizi açıklayınız..."></textarea>
                </div>

                <div class="col-md-6">
                    <label class="form-label-custom">Durum</label>
                    <select name="isActive" class="form-control-custom">
                        <option value="true">Aktif (Portfolyoda Göster)</option>
                        <option value="false">Pasif (Gizli)</option>
                    </select>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="reset" class="btn-pastel-secondary">
                        Temizle
                    </button>

                    <button type="submit" class="btn-pastel-primary">
                        <i class="bi bi-check-lg"></i>
                        Kaydet
                    </button>
                </div>

            </div>
        </form>
    </div>


</main>

<script>
    document.getElementById("tableSearchInput").addEventListener("input", function () {
        let search = this.value.toLocaleLowerCase("tr-TR");
        let rows = document.querySelectorAll("#experienceTableBody tr");

        rows.forEach(function (row) {
            let title = row.querySelector(".exp-title-text")
                .textContent.toLocaleLowerCase("tr-TR");

            row.style.display = title.includes(search) ? "" : "none";
        });
    });
        document.getElementById("statusFilterSelect").addEventListener("change", function () {
        let selectedStatus = this.value;
        let rows = document.querySelectorAll("#experienceTableBody tr");

        rows.forEach(function (row) {
            let status = row.getAttribute("data-status");

            row.style.display =
                selectedStatus === "all" || status === selectedStatus
                    ? ""
                    : "none";
        });
    });
           document.getElementById("btnRefreshTable").addEventListener("click", function () {
        window.location.href = '@Url.Action("ExperienceList", "Experience", new { area = "Admin" })';
    });
        function getSelectedIds() {
        let checkboxes = document.querySelectorAll(".row-select-checkbox:checked");

        let ids = Array.from(checkboxes).map(x => Number(x.value));

        return ids;
    }
     async function bulkAction(actionType) {
        let ids = getSelectedIds();

        if (ids.length === 0) {
            alert("Lütfen en az bir deneyim seçiniz.");
            return;
        }

           if (actionType === "delete") {
        const result = await Swal.fire({
            title: "Emin misiniz?",
            text: "Seçilen deneyimler kalıcı olarak silinecek!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Sil",
            cancelButtonText: "İptal",
            confirmButtonColor: "#d33"
        });

        if (!result.isConfirmed) {
            return;
        }
    }
        let data = new URLSearchParams();

        ids.forEach(id => data.append("ids", id));
        data.append("actionType", actionType);

        fetch('/Admin/Experience/BulkAction', {
            method: 'POST',
            body: data
        })
        .then(response => {
            if (response.ok) {
                location.reload();
            } else {
                alert("İşlem başarısız oldu.");
            }
        })
        .catch(() => alert("Sunucuya bağlanılamadı."));
    }

        document.getElementById("selectAllCheckbox").addEventListener("change", function () {
        document.querySelectorAll(".row-select-checkbox").forEach(function (checkbox) {
            checkbox.checked = document.getElementById("selectAllCheckbox").checked;
        });
    });
</script>

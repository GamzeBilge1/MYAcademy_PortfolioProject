@model Education

@{
    ViewData["Title"] = "UpdateEducation";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="data-table-card p-4">

        <h4 class="fw-bold mb-4">Eğitim Güncelle</h4>

        <form method="post"
            >

            <input type="hidden" asp-for="EducationId" />

            <div class="mb-3">
                <label class="form-label">Eğitim Başlığı</label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Okul Adı</label>
                <input asp-for="SchoolName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Kategori</label>
                <input asp-for="CategoryName" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Durum</label>
                <select asp-for="isActive" class="form-select">
                    <option value="true">Aktif</option>
                    <option value="false">Pasif</option>
                </select>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-pastel-primary">
                    <i class="bi bi-check-lg me-2"></i>
                    Değişiklikleri Kaydet
                </button>

                <a href="/Admin/Education/Index" class="btn btn-outline-secondary">
                    İptal
                </a>
            </div>

        </form>
    </div>
</div>

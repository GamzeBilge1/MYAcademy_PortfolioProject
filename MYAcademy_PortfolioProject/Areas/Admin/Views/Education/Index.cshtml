@model List<MYAcademy_PortfolioProject.Entities.Education>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="data-table-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Eğitim Bilgileri</h4>
            <a href="/Admin/Education/CreateEducation" class="btn btn-pastel-primary">
                <i class="bi bi-plus-lg me-2"></i>Yeni Eğitim Ekle
            </a>
        </div>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Eğitim Başlığı</th>
                    <th>Okul Adı</th>
                    <th>Açıklama</th>
                    <th>Kategori</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.SchoolName</td>
                        <td>@item.Description</td>
                        <td>@item.CategoryName</td>
                        <td>
                            @if (item.isActive)
                            {
                                <span class="status-pill status-active">Aktif</span>
                            }
                            else
                            {
                                <span class="status-pill status-passive">Pasif</span>
                            }
                        </td>

                        <td>
                            <div class="row-actions-group justify-content-end">

                                <a href="/Admin/Education/UpdateEducation/@item.EducationId"
                                   class="btn-action-icon btn-edit"
                                   title="Güncelle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form action="/Admin/Education/DeleteEducation/@item.EducationId"
                                      method="post" class="delete-form">

                                    <button type="submit"
                                            class="btn-action-icon btn-delete"
                                            title="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </button>

                                </form>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@model Skill
@{
    ViewData["Title"] = "UpdateSkill";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="data-table-card p-4">

        <h4 class="fw-bold mb-4">Yetenek Kategorisi Güncelle</h4>

        <form method="post" asp-area="Admin" asp-controller="Skill" asp-action="UpdateSkill">

            <input type="hidden" asp-for="SkillId" />

            <div class="mb-3">
                <label class="form-label">Kategori Adı</label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">İkon Sınıfı</label>
                <input asp-for="IconUrl" class="form-control" />
            </div>

            <hr class="my-4" />

            <h5 class="fw-bold mb-3">Kategoriye Ait Yetenekler</h5>

            @for (int i = 0; i < Model.SkillItems.Count; i++)
            {
                <input type="hidden" asp-for="SkillItems[i].SkillItemId" />

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label">Yetenek Adı</label>
                        <input asp-for="SkillItems[i].SkillItemTitle"
                               class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Seviye (0-100)</label>
                        <input asp-for="SkillItems[i].Level"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control" required />
                    </div>
                </div>
            }

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-pastel-primary">
                    <i class="bi bi-check-lg me-2"></i>Değişiklikleri Kaydet
                </button>

                <a href="/Admin/Skill/Index" class="btn btn-outline-secondary">
                    İptal
                </a>
            </div>

        </form>
    </div>
</div>

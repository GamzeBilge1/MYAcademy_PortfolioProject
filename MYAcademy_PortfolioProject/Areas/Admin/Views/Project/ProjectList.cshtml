@model List<Project>
@{
    ViewData["Title"] = "ProjectList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="data-table-card p-4">


        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Projelerim</h4>

            <a href="/Admin/Project/CreateProject" class="btn btn-pastel-primary">
                <i class="bi bi-plus-lg me-2"></i>Yeni Proje Ekle
            </a>
        </div>
        <div class="d-flex gap-3">

            <form method="get" >
                <select name="sort" class="filter-select" onchange="this.form.submit()">
                    <option value="">Sıralama Seçiniz</option>
                    <option value="newest">En Yeni Projeler</option>
                    <option value="">En Eski Projeler</option>
                </select>
            </form>

            <form method="get">
                <select name="categoryId"
                        class="filter-select"
                        onchange="this.form.submit()">

                    <option value="">Tüm Kategoriler</option>

                    @foreach (var item in ViewBag.Categories)
                    {
                        if (item.CategoryId == ViewBag.SelectedCategory)
                        {
                            <option value="@item.CategoryId" selected>
                                @item.CategoryName
                            </option>
                        }
                        else
                        {
                            <option value="@item.CategoryId">
                                @item.CategoryName
                            </option>
                        }
                    }
                </select>
            </form>

        </div>
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Proje Adı</th>
                    <th>Açıklama</th>
                    <th>Teknolojiler</th>
                    <th>Kategori</th>
                    
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProjectId</td>
                        <td>@item.ProjectName</td>
                        <td>@item.ProjectDescription</td>
                        <td>@item.Technology</td>
                        <td>@item.Category?.CategoryName</td>


                        <td>
                            @if (item.isActive)
                            {
                                <span class="status-pill status-active">Aktif</span>
                            }
                            else
                            {
                                <span class="status-pill status-passive">Pasif</span>
                            }
                        </td>

                        <td>
                            <div class="row-actions-group justify-content-end">

                                <a href="/Admin/Project/UpdateProject/@item.ProjectId"
                                   class="btn-action-icon btn-edit"
                                   title="Güncelle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form action="/Admin/Project/DeleteProject/@item.ProjectId"
                                      method="post" class="delete-form">

                                    <button type="submit"
                                            class="btn-action-icon btn-delete"
                                            title="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </button>

                                </form>

                            </div>
                        </td>

                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

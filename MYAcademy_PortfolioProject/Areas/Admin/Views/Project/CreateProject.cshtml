@model Project

@{
    ViewData["Title"] = "CreateProject";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-4">
    <div class="data-table-card p-4">

        <h4 class="fw-bold mb-4">Yeni Proje Ekle</h4>

        <form method="post"
              asp-area="Admin"
              asp-controller="Project"
              asp-action="CreateProject"
              enctype="multipart/form-data">

            <div class="mb-3">
                <label class="form-label">Proje Adı</label>
                <input asp-for="ProjectName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="ProjectDescription"
                          class="form-control" rows="3" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Teknolojiler</label>
                <input asp-for="Technology" class="form-control"
                       placeholder="Örn: C#, ASP.NET Core, SQL Server" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Kategori</label>
                <select asp-for="CategoryId"
                        asp-items="ViewBag.Categories"
                        class="form-select"
                        required>
                    <option value="">Kategori Seçiniz</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Proje Görseli</label>
                <input type="file" name="imageFile"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Durum</label>
                <select asp-for="isActive" class="form-select">
                    <option value="true">Aktif</option>
                    <option value="false">Pasif</option>
                </select>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-pastel-primary">
                    <i class="bi bi-check-lg me-2"></i>Kaydet
                </button>

                <a href="/Admin/Project/ProjectList"
                   class="btn btn-outline-secondary">
                    İptal
                </a>
            </div>

        </form>
    </div>
</div>

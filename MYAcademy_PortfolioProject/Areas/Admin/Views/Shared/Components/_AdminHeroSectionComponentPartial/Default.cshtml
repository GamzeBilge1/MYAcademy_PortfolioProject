<!-- Ana Sayfa İçerikleri -->

<div class="data-table-card p-4 mb-4">

    <h5 class="mb-4">
        <i class="bi bi-house-door me-2"></i>
        Ana Sayfa İçerikleri
    </h5>


    <form method="post" asp-action="UpdateHero">

        <input type="hidden"
               name="HeroSectionId"
               value="@ViewBag.hero.HeroSectionId" />

        <div class="row g-4">

            <!-- SOL TARAF -->
            <div class="col-lg-8">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Karşılama</label>
                    <input type="text"
                           name="Greeting"
                           class="form-control"
                           value="@ViewBag.hero.Greeting" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Başlık</label>
                    <input type="text"
                           name="Title"
                           class="form-control"
                           value="@ViewBag.hero.Title" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Açıklama</label>
                    <textarea name="Description"
                              class="form-control"
                              rows="5">@ViewBag.hero.Description</textarea>
                </div>

            </div>

            <!-- SAĞ TARAF -->
            <div class="col-lg-4">

                <label class="form-label fw-semibold">Görsel</label>

                <img id="heroImagePreview"
                     src="@ViewBag.hero.MainImageUrl"
                     alt="Görsel"
                     class="w-100 rounded mb-3"
                     style="height:300px; object-fit:contain;" />

                <input type="text"
                       name="MainImageUrl"
                       id="heroImageUrl"
                       class="form-control"
                       value="@ViewBag.hero.MainImageUrl"
                       placeholder="Görsel URL" />

            </div>

        </div>

        <div class="text-end mt-4">
            <button type="submit" class="btn-pastel-primary">
                <i class="bi bi-check-circle me-2"></i>
                Değişiklikleri Kaydet
            </button>
        </div>

    </form>

</div>
<script>
    document.getElementById("heroImageUrl")?.addEventListener("input", function () {
        document.getElementById("heroImagePreview").src = this.value;
    });
</script>
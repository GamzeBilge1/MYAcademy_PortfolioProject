
<div class="data-table-card p-4 mb-4">

    <h5 class="mb-4">
        <i class="bi bi-person me-2"></i>
        Hakkımda İçerikleri
    </h5>

    <form method="post" asp-area="Admin" asp-controller="About" asp-action="UpdateAbout">

        <input type="hidden"
               name="AboutId"
               value="@ViewBag.about.AboutId" />

        <div class="row g-4">

            <!-- SOL TARAF -->
            <div class="col-lg-8">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Ad Soyad</label>
                        <input type="text" name="FullName" class="form-control"
                               value="@ViewBag.about.FullName" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Konum</label>
                        <input type="text" name="Location" class="form-control"
                               value="@ViewBag.about.Location" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Unvan</label>
                        <input type="text" name="JobTitle" class="form-control"
                               value="@ViewBag.about.JobTitle" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Başlık</label>
                        <input type="text" name="Title" class="form-control"
                               value="@ViewBag.about.Title" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Birinci Açıklama</label>
                        <textarea name="Description1" class="form-control" rows="3">@ViewBag.about.Description1</textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">İkinci Açıklama</label>
                        <textarea name="Description2" class="form-control" rows="3">@ViewBag.about.Description2</textarea>
                    </div>

                </div>
            </div>

            <!-- SAĞ TARAF -->
            <div class="col-lg-4">

                <label class="form-label fw-semibold">Görsel</label>

                <img id="aboutImagePreview"
                     src="@ViewBag.about.ImageUrl"
                     alt="Görsel"
                     class="w-100 rounded mb-3"
                     style="height:300px; object-fit:contain;" />

                <input type="text"
                       name="ImageUrl"
                       id="aboutImageUrl"
                       class="form-control"
                       value="@ViewBag.about.ImageUrl"
                       placeholder="Görsel URL" />

                <div class="mt-3">
                    <label class="form-label fw-semibold">CV Bağlantısı</label>
                    <input type="text"
                           name="CvUrl"
                           class="form-control"
                           value="@ViewBag.about.CvUrl" />
                </div>

            </div>
        </div>

        <!-- İSTATİSTİKLER -->
        <h6 class="mt-4 mb-3">İstatistik Bilgileri</h6>

        <div class="row g-3">

            <div class="col-md-4">
                <label class="form-label fw-semibold">1. İstatistik</label>
                <input name="Statistic1Value" class="form-control mb-2"
                       value="@ViewBag.about.Statistic1Value"
                       placeholder="Değer" />
                <input name="Statistic1Title" class="form-control"
                       value="@ViewBag.about.Statistic1Title"
                       placeholder="Başlık" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">2. İstatistik</label>
                <input name="Statistic2Value" class="form-control mb-2"
                       value="@ViewBag.about.Statistic2Value"
                       placeholder="Değer" />
                <input name="Statistic2Title" class="form-control"
                       value="@ViewBag.about.Statistic2Title"
                       placeholder="Başlık" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">3. İstatistik</label>
                <input name="Statistic3Value" class="form-control mb-2"
                       value="@ViewBag.about.Statistic3Value"
                       placeholder="Değer" />
                <input name="Statistic3Title" class="form-control"
                       value="@ViewBag.about.Statistic3Title"
                       placeholder="Başlık" />
            </div>

        </div>

        <div class="text-end mt-4">
            <button type="submit" class="btn-pastel-primary">
                <i class="bi bi-check-circle me-2"></i>
                Değişiklikleri Kaydet
            </button>
        </div>

    </form>
</div>

<script>
    document.getElementById("aboutImageUrl")?.addEventListener("input", function () {
        document.getElementById("aboutImagePreview").src = this.value;
    });
</script>

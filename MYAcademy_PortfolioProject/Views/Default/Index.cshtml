@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_DefaultHeaderComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultNavbarComponentPartial")
    <main>
        @await Component.InvokeAsync("_DefaultHeroSectionComponentPartial")
        @await Component.InvokeAsync("_DefaultAboutComponentPartial")
        @await Component.InvokeAsync("_DefaultSkillComponentPartial")
        @await Component.InvokeAsync("_DefaultExperienceComponentPartial")
        @await Component.InvokeAsync("_DefaultProjectComponentPartial")
        @await Component.InvokeAsync("_DefaultEducationComponentPartial")

        <!-- 10. Personal Philosophy Section -->
        <section class="philosophy-section text-center">
            <div class="container">
                <div class="mx-auto reveal-on-scroll" style="max-width: 820px;">
                    <div class="mb-3 text-secondary" style="font-size: 2.5rem; line-height: 1;">
                        <i class="bi bi-code-slash text-light opacity-50"></i>
                    </div>
                    <p class="philosophy-quote mb-4">
                        "İyi yazılım yalnızca çalışan kod değil, gerçek bir probleme üretilmiş anlamlı bir çözümdür."
                    </p>
                    <div class="d-inline-flex align-items-center gap-2 text-white-50 small font-heading">
                        <span class="w-12 h-px bg-white-50"></span>
                        <span>Murat Yücedağ — Yazılım Felsefesi</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 11. Contact Section -->
        <section id="contact">
            <div class="container">
                <div class="row gy-5">
                    <!-- Left Column: Contact Info -->
                    <div class="col-lg-5 reveal-on-scroll">
                        <div class="eyebrow-badge">
                            <i class="bi bi-envelope-paper-fill"></i> İLETİŞİME GEÇELİM
                        </div>
                        <h2 class="section-title">
                            Harika Bir Fikrin mi Var? Birlikte Hayata Geçirelim.
                        </h2>
                        <p class="text-muted mb-4 fs-6">
                            Yeni projeler, eğitimler, iş birlikleri veya yalnızca teknoloji üzerine sohbet etmek için benimle iletişime geçebilirsin.
                        </p>

                        <div class="d-flex flex-column gap-3 mb-4">
                            <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">
                                <div class="skill-icon-box mb-0" style="width: 44px; height: 44px; background: var(--bg-secondary);">
                                    <i class="bi bi-envelope"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">E-posta</div>
                                    <div class="fw-semibold">murat.yucedag@example.com</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">
                                <div class="skill-icon-box mb-0" style="width: 44px; height: 44px; background: var(--bg-secondary);">
                                    <i class="bi bi-geo-alt"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Konum</div>
                                    <div class="fw-semibold">İstanbul, Türkiye</div>
                                </div>
                            </div>
                        </div>

                        <!-- Social links -->
                        <div class="pt-2">
                            <div class="text-muted small font-heading fw-semibold mb-2">Sosyal Ağlar:</div>
                            <div class="d-flex gap-2">
                                <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-pill" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-pill" title="GitHub"><i class="bi bi-github"></i></a>
                                <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-pill" title="YouTube"><i class="bi bi-youtube"></i></a>
                                <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-pill" title="Instagram"><i class="bi bi-instagram"></i></a>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Form -->
                    <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                        <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
                            <form id="contactForm" onsubmit="event.preventDefault(); validateForm();">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="fullName" class="form-label small fw-semibold">Adınız Soyadınız *</label>
                                        <input type="text" class="form-control form-control-custom" id="fullName" placeholder="Örn: Ahmet Yılmaz" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="emailAddr" class="form-label small fw-semibold">E-posta Adresiniz *</label>
                                        <input type="email" class="form-control form-control-custom" id="emailAddr" placeholder="ad@ornek.com" required>
                                    </div>
                                    <div class="col-12">
                                        <label for="subject" class="form-label small fw-semibold">Konu</label>
                                        <input type="text" class="form-control form-control-custom" id="subject" placeholder="Örn: Kurumsal .NET Eğitimi veya Danışmanlık">
                                    </div>
                                    <div class="col-12">
                                        <label for="message" class="form-label small fw-semibold">Mesajınız *</label>
                                        <textarea class="form-control form-control-custom" id="message" rows="5" placeholder="Projeniz veya sorunuz hakkında detayları paylaşın..." required></textarea>
                                    </div>
                                    <div class="col-12 pt-2">
                                        <button type="submit" class="btn-sage w-100 justify-content-center py-3 fs-6">
                                            <i class="bi bi-send-fill"></i>
                                            <span>Mesajımı Gönder</span>
                                        </button>
                                        <div id="formFeedback" class="mt-2 text-center small text-muted"></div>
                                        <div class="text-muted text-center small mt-3" style="font-size: 0.78rem;">
                                            <i class="bi bi-shield-check me-1"></i> Gönderilen bilgiler gizlilik ilkeleri doğrultusunda korunmaktadır.
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- 12. Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between pb-4 border-bottom gap-3">
                <div>
                    <a class="navbar-brand-custom" href="#home">
                        <span>Murat Yücedağ.</span>
                    </a>
                    <p class="text-muted small mb-0 mt-1">Kod, yaratıcılık ve sürekli öğrenme.</p>
                </div>

                <!-- Quick Links -->
                <div class="d-flex gap-3">
                    <a href="#home" class="text-decoration-none text-muted small fw-medium">Ana Sayfa</a>
                    <a href="#about" class="text-decoration-none text-muted small fw-medium">Hakkımda</a>
                    <a href="#projects" class="text-decoration-none text-muted small fw-medium">Projelerim</a>
                    <a href="#contact" class="text-decoration-none text-muted small fw-medium">İletişim</a>
                </div>

                <button class="back-to-top-btn" id="backToTop" title="Yukarı Çık">
                    <i class="bi bi-arrow-up"></i>
                </button>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-3 gap-2">
                <div class="text-muted small">
                    © 2026 Murat Yücedağ. Tüm hakları saklıdır.
                </div>
                <div class="d-flex gap-2">
                    <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-muted small text-decoration-none me-2"><i class="bi bi-github"></i> GitHub</a>
                    <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="text-muted small text-decoration-none me-2"><i class="bi bi-linkedin"></i> LinkedIn</a>
                    <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="text-muted small text-decoration-none me-2"><i class="bi bi-youtube"></i> YouTube</a>
                    <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-muted small text-decoration-none"><i class="bi bi-instagram"></i> Instagram</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Vanilla JavaScript for Interactivity -->
    <script>
        // 1. Typewriter Animation for Hero Section
        (function initTypewriter() {
                 const phrases = window.heroTitles || [];
        if (phrases.length === 0) return;
          const targetElement = document.getElementById("typewriterText");
          if (!targetElement) return;

          let phraseIndex = 0;
          let charIndex = 0;
          let isDeleting = false;
          const typeSpeed = 80;
          const deleteSpeed = 40;
          const delayBetween = 1800;

          function typeCycle() {
            const currentPhrase = phrases[phraseIndex];
            if (isDeleting) {
              targetElement.textContent = currentPhrase.substring(0, charIndex - 1);
              charIndex--;
            } else {
              targetElement.textContent = currentPhrase.substring(0, charIndex + 1);
              charIndex++;
            }

            if (!isDeleting && charIndex === currentPhrase.length) {
              setTimeout(() => {
                isDeleting = true;
                typeCycle();
              }, delayBetween);
              return;
            } else if (isDeleting && charIndex === 0) {
              isDeleting = false;
              phraseIndex = (phraseIndex + 1) % phrases.length;
              setTimeout(typeCycle, 300);
              return;
            }

            setTimeout(typeCycle, isDeleting ? deleteSpeed : typeSpeed);
          }

          typeCycle();
        })();

        // 2. Fixed Navbar on Scroll
        window.addEventListener("scroll", function() {
          const navbar = document.getElementById("mainNavbar");
          if (window.scrollY > 40) {
            navbar.classList.add("scrolled");
          } else {
            navbar.classList.remove("scrolled");
          }
        });

        // 3. Active Nav Link on Scroll Spy
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll(".nav-link-custom");

        function updateActiveNav() {
          const scrollY = window.pageYOffset;
          sections.forEach(current => {
            const sectionHeight = current.offsetHeight;
            const sectionTop = current.offsetTop - 120;
            const sectionId = current.getAttribute("id");

            if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
              navLinks.forEach(link => {
                link.classList.remove("active");
                if (link.getAttribute("href") === "#" + sectionId) {
                  link.classList.add("active");
                }
              });
            }
          });
        }
        window.addEventListener("scroll", updateActiveNav);

        // 4. Mobile Menu Auto-close on click
        document.querySelectorAll(".mobile-nav-link").forEach(link => {
          link.addEventListener("click", () => {
            const mobileMenu = document.getElementById("mobileMenu");
            if (mobileMenu && mobileMenu.classList.contains("show")) {
              const bsCollapse = bootstrap.Collapse.getInstance(mobileMenu);
              if (bsCollapse) bsCollapse.hide();
            }
          });
        });

        // 5. Project Filtering (Vanilla JS)
        const filterButtons = document.querySelectorAll("#projectFilters .filter-btn");
        const projectItems = document.querySelectorAll("#projectGrid .project-item");

        filterButtons.forEach(btn => {
          btn.addEventListener("click", () => {
            filterButtons.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");

            const filterValue = btn.getAttribute("data-filter");
            projectItems.forEach(item => {
              const categories = item.getAttribute("data-category") || "";
              if (filterValue === "all" || categories.includes(filterValue)) {
                item.style.display = "block";
                item.style.opacity = "1";
              } else {
                item.style.display = "none";
                item.style.opacity = "0";
              }
            });
          });
        });

        // 6. Back to Top Button
        const backToTopBtn = document.getElementById("backToTop");
        if (backToTopBtn) {
          backToTopBtn.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
          });
        }

        // 7. Intersection Observer for Scroll Reveals
        const revealElements = document.querySelectorAll(".reveal-on-scroll");
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: "0px 0px -40px 0px"
        });

        revealElements.forEach(el => observer.observe(el));

        // 8. Contact Form Client-side Validation (ready for ASP.NET Core)
        function validateForm() {
          const name = document.getElementById("fullName").value.trim();
          const email = document.getElementById("emailAddr").value.trim();
          const message = document.getElementById("message").value.trim();
          const feedback = document.getElementById("formFeedback");

          if (!name || !email || !message) {
            feedback.innerHTML = '<span class="text-danger">Lütfen tüm zorunlu alanları doldurun.</span>';
            return;
          }

          const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
          if (!emailRegex.test(email)) {
            feedback.innerHTML = '<span class="text-danger">Geçerli bir e-posta adresi giriniz.</span>';
            return;
          }

          feedback.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i> Form doğrulandı. (ASP.NET Core Controller entegrasyonu için hazırdır)</span>';
        }
    </script>
</body>
</html>